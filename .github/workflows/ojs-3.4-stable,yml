on: [push, pull_request]
name: iiifviewer
jobs:
  iiifviewer:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - application: ojs
            php-version: 8.2
            database: mysql
          - application: ojs
            php-version: 8.3
            database: mysql

    name: iiifviewer
    steps:
      - uses: pkp/pkp-github-actions@v1
        with:
          node_version: 12
          branch: stable-3_4_0
          repository: pkp
          plugin: true
          dataset_inject: false